// lib/panduan.js
const axios = require("axios")
const fs = require("fs")

async function panduan(sock, msg) {
  const from = msg.key.remoteJid
  const text = `
🚀 Tentang

*Lx-Bot* adalah WhatsApp bot open-source berbasis Node.js + Baileys.
Dirancang untuk penggunaan pribadi maupun publik, dengan fitur ringan tanpa API premium.

---

✨ *Fitur Lx-bot WhatsApp*

*==🔧 Umum==*

!menu — Tampilkan daftar fitur

!owner — Info kontak owner bot

!ping — Cek respon bot

!runtime — Lama bot berjalan

!sc — Lihat source code bot

*==🎵 Musik & Download==*

!play <judul/link> — Download MP3 dari YouTube

!ytmp3 <link> — Download audio YouTube

!ytmp4 <link> — Download video YouTube

!tiktokdl <link> — Download video TikTok

!instagram <link> — Download video/foto Instagram

!brat — ✅ Fitur eksperimen

*==🖼️ Media & Stiker==*

!sticker — Ubah media jadi stiker

!toimg — Ubah stiker jadi foto

!brat — ✅ Fitur eksperimen


*==👥 Grup Tools (admin only)==*

!absen

!welcome

!tagall

!hidetag

!kick @user

!add <nomor>

!promote @user

!demote @user

!leave

---

⚙️ *Instalasi (Termux / Linux)*

- pkg update && pkg upgrade
- pkg install nodejs
- pkg install imagemagick
- pkg install ffmpeg
- git clone https://github.com/lilithxdef/Lx-bot-whatsapp
- cd Lx-bot-whatsapp
- npm install
- node index.js

---

🌟 Dukung Proyek Ini
Star & fork repo, bagikan ke teman

---

> 👤 LILITH
> Made with ❤️ by @LilithXdef
Gunakan dengan bijak, jangan spam. Ketik !owner jika ingin info.
`
await sock.sendMessage(from, {
    image: { url:  },
    caption: text
  })
}

module.exports = panduan
