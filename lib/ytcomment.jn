const fetch = require('node-fetch')

module.exports = async (sock, msg, args) => {
  const from = msg.key.remoteJid
  const sender = msg.key.participant || msg.key.remoteJid
  const text = args.join(' ')

  if (!text.includes('|')) {
    return sock.sendMessage(from, {
      text: '❌ Format: .ytcomment Nama|Komentar\nContoh: .ytcomment Lilith|Bot paling sadis!',
    }, { quoted: msg })
  }

  const [nama, komentar] = text.split('|')
  const avatar = 'https://i.ibb.co/LkL8gDL/user.png'

  const url = `https://nekobot.xyz/api/imagegen?type=youtubecomment&username=${encodeURIComponent(nama)}&comment=${encodeURIComponent(komentar)}&image=${encodeURIComponent(avatar)}`

  try {
    const res = await fetch(url)
    const json = await res.json()

    if (!json || !json.message || !json.message.startsWith('http')) {
      return sock.sendMessage(from, {
        text: '❌ Gagal membuat gambar komentar. Coba lagi nanti.',
      }, { quoted: msg })
    }

    await sock.sendMessage(from, {
      image: { url: json.message },
      caption: `📸 Komentar YouTube oleh *${nama}*`,
    }, { quoted: msg })
  } catch (e) {
    return sock.sendMessage(from, {
      text: `❌ Gagal: ${e.message}`,
    }, { quoted: msg })
  }
}
